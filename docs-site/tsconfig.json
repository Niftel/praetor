{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["${configDir}/*"]
    },
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": ["${configDir}/.docusaurus", "${configDir}/build"]
}
